header {
    background: linear-gradient(135deg, #1a73e8, #34a853);
    color: white;
    padding: 14px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}
.brand img {
    height: 50px;
    width: 50px;
    border-radius: 50%;
    background: white;
    padding: 3px;
    object-fit: contain;
}
.brand h1 {
    font-size: 20px;
    margin: 0;
}
